# Copy this file to .env in the project root and fill in the keys you need.
# Existing environment variables take precedence over .env.

# Required for the first data build; not needed to preview the landing page.
CENSUS_API_KEY=

# Optional: enables paid Claude answers if a key is configured here or elsewhere.
# --basic-only disables model calls even when this key is configured.
ANTHROPIC_API_KEY=
